# Validator Agent Environment Configuration
# Copy this file to .env and fill in your actual values

# =============================================================================
# ADAPTER SELECTION (Primary Configuration)
# =============================================================================
# These variables control which adapter implementations are used.
# All default to "stub" for local development with no external dependencies.

# MRC (Material Readiness Checker) - blur detection
# Options: stub, vertex_ai
MRC_ADAPTER=stub

# OCR (Optical Character Recognition) - text extraction
# Options: stub, vertex_ai
OCR_ADAPTER=stub

# LLM Provider - content safety analysis and reasoning
# Options: stub, google_ai_studio, vertex_ai
LLM_PROVIDER=stub

# Knowledge Service - where to send validated content
# Options: stub, http, grpc
KNOWLEDGE_ADAPTER=stub

# Decision Audit - where to log validation decisions
# Options: stub, postgres, grpc
AUDIT_ADAPTER=stub

# Event Publisher - messaging/notification system
# Options: stub, pubsub, real, emulator
# Note: "pubsub" uses real GCP Pub/Sub, "emulator" for local testing, "real" also works
EVENT_ADAPTER=stub

# Storage - where to download files from
# Options: stub, local, gcs
# Note: "local" for E2E testing with local files, "gcs" for Google Cloud Storage
STORAGE_ADAPTER=stub

# Tracing - observability and monitoring
# Options: stub, langfuse
# TRACING_ADAPTER=stub

# =============================================================================
# LANGFUSE CONFIGURATION (for TRACING_ADAPTER=langfuse)
# =============================================================================
# Required - Get from Langfuse dashboard: https://cloud.langfuse.com
# LANGFUSE_PUBLIC_KEY=pk-lf-...
# LANGFUSE_SECRET_KEY=sk-lf-...

# Optional - Langfuse server URL (default: https://cloud.langfuse.com)
# For self-hosted Langfuse: http://localhost:3000
# LANGFUSE_HOST=https://cloud.langfuse.com

# =============================================================================
# RUNTIME MODE
# =============================================================================
# Controls authentication behavior for GCP services
# Options: dev (uses gcloud CLI), prod (uses GKE Workload Identity)
APP_MODE=dev

# =============================================================================
# MRC (MATERIAL READINESS CHECKER) CONFIGURATION
# =============================================================================
# Vertex AI endpoint for blur detection
# Default: https://asia-southeast1-aiplatform.googleapis.com/v1/projects/aflow-491809/locations/asia-southeast1/endpoints/mrc-endpoint-production:rawPredict
# MRC_ENDPOINT=

# Blurry page threshold (0.0-1.0). Files with >30% blurry pages are rejected
# Default: 0.30
# MRC_BLUR_THRESHOLD=0.30

# =============================================================================
# GOOGLE CLOUD / VERTEX AI CONFIGURATION
# =============================================================================
# Required when OCR_ADAPTER=vertex_ai or MRC_ADAPTER=vertex_ai
# Download service account key from GCP Console and set path:
# GOOGLE_APPLICATION_CREDENTIALS=/path/to/service-account-key.json
#
# Required GCP roles for the service account:
#   - roles/documentai.apiUser    (for OCR - Document AI)
#   - roles/aiplatform.user       (for MRC - Vertex AI blur detection)
# Optional (if using GCS storage):
#   - roles/storage.objectViewer  (for Cloud Storage)

# GCP Project ID for Document AI
# Default: accessorflow
# GCP_PROJECT_ID=accessorflow

# GCP Region/Location for Document AI
# Default: asia-southeast1
# GCP_LOCATION=asia-southeast1

# Document AI Processor ID
# Default: dabf82e23a09dead
# DOCUMENTAI_PROCESSOR_ID=dabf82e23a09dead

# =============================================================================
# VISUAL PROCESSING CONFIGURATION
# =============================================================================
# Enable visual understanding (GPT-4o image analysis)
# Default: true
# ENABLE_VISUAL=true

# Batch size for visual page processing (controls parallelization)
# Default: 3
# VISUAL_BATCH_SIZE=3

# Stagger delay between batches (seconds) to avoid rate limits
# Default: 2.0
# VISUAL_BATCH_STAGGER_SECONDS=2.0

# Visual understanding model overrides
# Default: gpt-4.1-mini
# GENERATOR_MODEL=gpt-4.1-mini
# EVALUATOR_MODEL=gpt-4.1-mini

# =============================================================================
# MODEL BROKER CONFIGURATION
# =============================================================================
# Required when LLM_PROVIDER=vertex_ai or google_ai_studio
# URL of the Model Broker service (routes LLM calls with budget tracking)
# Default: http://localhost:8010
# MODEL_BROKER_URL=http://localhost:8010

# Timeout for Model Broker requests (seconds)
# Default: 60
# MODEL_BROKER_TIMEOUT=60

# =============================================================================
# OPENAI CONFIGURATION
# =============================================================================
# Required for moderation pre-filter and visual understanding fallback
# Get from: https://platform.openai.com/api-keys
# OPENAI_API_KEY=sk-...

# =============================================================================
# KNOWLEDGE SERVICE CONFIGURATION
# =============================================================================
# Required when KNOWLEDGE_ADAPTER=http
# URL of the Knowledge Service API
# Default: http://localhost:8020
# KNOWLEDGE_SERVICE_URL=http://localhost:8020

# =============================================================================
# STORAGE CONFIGURATION
# =============================================================================
# Required when STORAGE_ADAPTER=local
# Directory for local file storage
# Default: /tmp/assessorflow-uploads
# UPLOAD_DIR=/tmp/assessorflow-uploads

# Required when STORAGE_ADAPTER=gcs
# GCS bucket name for file storage
# GCS_BUCKET_NAME=your-bucket-name

# =============================================================================
# DECISION AUDIT (POSTGRES) CONFIGURATION
# =============================================================================
# Required when AUDIT_ADAPTER=postgres
# Default values point to local Cloud SQL Proxy

# Database host
# Default: localhost
# AUDIT_DB_HOST=localhost

# Database port
# Default: 15432
# AUDIT_DB_PORT=15432

# Database name
# Default: af_decision_audit
# AUDIT_DB_NAME=af_decision_audit

# Database user
# Default: assessorflow
# AUDIT_DB_USER=assessorflow

# Database password
# Default: dev_password
# AUDIT_DB_PASSWORD=dev_password

# =============================================================================
# ORCHESTRATOR DATABASE (LEGACY)
# =============================================================================
# Legacy database configuration for direct orchestrator DB access (deprecated)
# Default values point to local Cloud SQL Proxy

# Default: localhost
# ORCHESTRATOR_DB_HOST=localhost

# Default: 15432
# ORCHESTRATOR_DB_PORT=15432

# Default: af_orchestrator
# ORCHESTRATOR_DB_NAME=af_orchestrator

# Default: assessorflow
# ORCHESTRATOR_DB_USER=assessorflow

# Default: dev_password
# ORCHESTRATOR_DB_PASSWORD=dev_password

# =============================================================================
# PUB/SUB CONFIGURATION
# =============================================================================
# Required when EVENT_ADAPTER=pubsub or emulator
# GCP Project ID for Pub/Sub
# PUBSUB_PROJECT_ID=your-project-id

# Pub/Sub emulator host (for local testing)
# Example: localhost:8085
# PUBSUB_EMULATOR_HOST=localhost:8085

# =============================================================================
# API SERVER CONFIGURATION
# =============================================================================
# URL of the AssessorFlow API Server (used in event-driven mode)
# Default: http://localhost:8001
# API_SERVER_URL=http://localhost:8001

# =============================================================================
# SERVICE CONFIGURATION
# =============================================================================
# Port for the Validator Agent service
# Default: 8080
# PORT=8080

# Host to bind the service
# Default: 0.0.0.0
# HOST=0.0.0.0
